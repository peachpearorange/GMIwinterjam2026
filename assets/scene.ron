(
    camera: (
        fov_degrees: 62.0,
        near: 0.1,
        far: 1000.0,
        ev100: 10.0,
        tone_mapping: ReinhardLuminance,
        deband_dither: false,
        hdr: true,
        anti_aliasing: Msaa4,
        ambient_occlusion: false,
        background: "#2b2c2f",
        fog: (
            on: false,
            color: "#ffffff",
            kind: Exponential,
            start: 0.0,
            end: 100.0,
            density: 0.002,
            sun_color: "#000000",
            sun_exponent: 36.0,
            sky_horizon: 0.2,
            sky_top: 0.0,
            sky_fade_degrees: 20.0,
        ),
        glow: (
            on: false,
            intensity: 0.15,
            low_frequency_boost: 0.7,
            low_frequency_boost_curvature: 0.95,
            high_pass_frequency: 1.0,
            threshold: 0.0,
            threshold_softness: 0.0,
            additive: false,
        ),
        grading: (
            exposure: 0.0,
            temperature: 0.0,
            tint: 0.0,
            hue: 0.0,
            saturation: 1.0,
            shadows: (
                saturation: 1.0,
                contrast: 1.0,
                gamma: 1.0,
                gain: 1.0,
                lift: 0.0,
            ),
            midtones: (
                saturation: 1.0,
                contrast: 1.0,
                gamma: 1.0,
                gain: 1.0,
                lift: 0.0,
            ),
            highlights: (
                saturation: 1.0,
                contrast: 1.0,
                gamma: 1.0,
                gain: 1.0,
                lift: 0.0,
            ),
        ),
        fly: (
            sensitivity: 0.55,
            walk_speed: 40.0,
            run_speed: 120.0,
            scroll_factor: 0.18,
            friction: 40.0,
        ),
    ),
    sun: (
        color: "#ffffff",
        illuminance: 500.0,
        elevation_degrees: 38.0,
        azimuth_degrees: 53.1,
        shadows: true,
        shadow_depth_bias: 0.02,
        shadow_normal_bias: 1.8,
        shadow_filtering: Gaussian,
        shadow_map_size: 2048,
        cascades: 4,
        first_cascade_far_bound: 10.0,
        shadow_distance: 150.0,
        cascade_overlap: 0.2,
        image: Some("textures/moon.png"),
        image_degrees: 5.0,
        image_brightness: 1.0,
    ),
    ambient: (
        color: "#ffffff",
        brightness: 900.0,
    ),
    sky: (
        brightness: 1500.0,
    ),
)